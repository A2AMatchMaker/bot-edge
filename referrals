<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Referral Dashboard — BotEdge</title>
    <style>
        :root {
            --primary: #00ff88;
            --secondary: #00d4ff;
            --bg-dark: #0a0a0f;
            --bg-card: #12121a;
            --bg-hover: #1a1a25;
            --text-primary: #ffffff;
            --text-secondary: #a0a0b0;
            --border: #2a2a3a;
            --success: #00ff88;
            --warning: #ffaa00;
        }
        
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg-dark);
            color: var(--text-primary);
            line-height: 1.6;
        }
        
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
        
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 30px 0;
            border-bottom: 1px solid var(--border);
            margin-bottom: 40px;
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--text-primary);
        }
        
        .logo-icon {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: bold;
            color: var(--bg-dark);
        }
        
        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: var(--bg-dark);
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0, 255, 136, 0.3);
        }
        
        .btn-large {
            padding: 16px 32px;
            font-size: 16px;
        }
        
        h1 { font-size: 32px; margin-bottom: 30px; }
        
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }
        
        .dashboard-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 30px;
        }
        
        .dashboard-card h3 {
            font-size: 14px;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 15px;
        }
        
        .dashboard-value {
            font-size: 36px;
            font-weight: 700;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .dashboard-sub {
            font-size: 13px;
            color: var(--text-secondary);
            margin-top: 8px;
        }
        
        .referral-section {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 30px;
            margin-bottom: 40px;
        }
        
        .referral-section h2 {
            font-size: 24px;
            margin-bottom: 20px;
        }
        
        .referral-link-box {
            display: flex;
            gap: 10px;
            background: var(--bg-dark);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
        }
        
        .referral-link-box input {
            flex: 1;
            background: transparent;
            border: none;
            color: var(--text-primary);
            font-family: monospace;
            font-size: 14px;
            outline: none;
        }
        
        .share-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        
        .share-btn {
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
        }
        
        .share-twitter {
            background: #1DA1F2;
            color: white;
        }
        
        .share-copy {
            background: var(--bg-hover);
            color: var(--text-primary);
            border: 1px solid var(--border);
        }
        
        .referrals-table {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 30px;
            margin-bottom: 40px;
            overflow-x: auto;
        }
        
        .referrals-table h2 {
            font-size: 24px;
            margin-bottom: 20px;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
        }
        
        th {
            text-align: left;
            padding: 15px;
            font-size: 12px;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid var(--border);
        }
        
        td {
            padding: 15px;
            font-size: 14px;
            border-bottom: 1px solid var(--border);
        }
        
        .status-badge {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .status-active {
            background: rgba(0, 255, 136, 0.1);
            color: var(--success);
        }
        
        .level-badge {
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
        }
        
        .level-1 {
            background: rgba(0, 255, 136, 0.2);
            color: var(--primary);
        }
        
        .claim-section {
            background: linear-gradient(135deg, rgba(0, 255, 136, 0.1), rgba(0, 212, 255, 0.1));
            border: 1px solid var(--primary);
            border-radius: 12px;
            padding: 30px;
            text-align: center;
            margin-bottom: 40px;
        }
        
        .claim-section h2 {
            font-size: 24px;
            margin-bottom: 10px;
        }
        
        .claim-amount {
            font-size: 48px;
            font-weight: 700;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin: 20px 0;
        }
        
        footer {
            text-align: center;
            padding: 40px 0;
            border-top: 1px solid var(--border);
            color: var(--text-secondary);
            font-size: 13px;
        }
        
        .notification {
            position: fixed;
            bottom: 30px;
            right: 30px;
            padding: 15px 25px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 8px;
            display: none;
            z-index: 1000;
        }
        
        .notification.show {
            display: block;
        }
        
        .notification.success {
            border-color: var(--success);
        }
        
        .notification.error {
            border-color: #ff4466;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <a href="index.html" class="logo">
                <div class="logo-icon">⚡</div>
                <h1>BotEdge</h1>
            </a>
            <div>
                <span id="walletStatus" style="color: var(--text-secondary); margin-right: 15px;">Not Connected</span>
                <button class="btn btn-primary" onclick="connectWallet()">Connect Wallet</button>
            </div>
        </header>
        
        <h1>🎯 Referral Dashboard</h1>
        <p style="color: var(--text-secondary); margin-bottom: 30px;">
            Earn 30% of platform fees from sellers you refer — forever.
        </p>
        
        <div class="dashboard-grid">
            <div class="dashboard-card">
                <h3>Available to Claim</h3>
                <div class="dashboard-value" id="claimableEarnings">0 ETH</div>
                <div class="dashboard-sub">Ready to withdraw now</div>
            </div>
            <div class="dashboard-card">
                <h3>Total Earned</h3>
                <div class="dashboard-value" id="totalEarned">0 ETH</div>
                <div class="dashboard-sub">All-time referral earnings</div>
            </div>
            <div class="dashboard-card">
                <h3>Total Referrals</h3>
                <div class="dashboard-value" id="totalReferrals">0</div>
                <div class="dashboard-sub">Across all levels</div>
            </div>
            <div class="dashboard-card">
                <h3>Level Breakdown</h3>
                <div class="dashboard-value" style="font-size: 20px;">
                    <span id="level1Count">0</span> L1 • 
                    <span id="level2Count">0</span> L2 • 
                    <span id="level3Count">0</span> L3
                </div>
                <div class="dashboard-sub">Direct / Indirect / Network</div>
            </div>
        </div>
        
        <div class="claim-section">
            <h2>💰 Ready to Claim?</h2>
            <p class="claim-sub" style="color: var(--text-secondary); margin-bottom: 25px;">Your accumulated referral earnings are waiting</p>
            <div class="claim-amount" id="claimAmount">0 ETH</div>
            <button class="btn btn-primary btn-large" onclick="claimEarnings()">
                Claim Earnings Now
            </button>
        </div>
        
        <div class="referral-section">
            <h2>🔗 Your Referral Link</h2>
            <p style="color: var(--text-secondary); margin-bottom: 20px;">
                Share this link with potential sellers. When they list and make sales, you earn 30% of the platform fee — forever.
            </p>
            <div class="referral-link-box">
                <input type="text" id="referralLink" readonly value="Connect wallet to generate your link">
                <button class="btn btn-secondary" onclick="copyLink()">Copy</button>
            </div>
            <div class="share-buttons">
                <button class="share-btn share-twitter" onclick="shareTwitter()">
                    🐦 Share on Twitter
                </button>
                <button class="share-btn share-copy" onclick="copyLink()">
                    📋 Copy Link
                </button>
            </div>
        </div>
        
        <div class="referrals-table">
            <h2>👥 Your Referrals</h2>
            <table>
                <thead>
                    <tr>
                        <th>Address</th>
                        <th>Level</th>
                        <th>Status</th>
                        <th>Earnings Generated</th>
                        <th>Your Cut</th>
                    </tr>
                </thead>
                <tbody id="referralsTableBody">
                    <tr>
                        <td colspan="5" style="text-align: center; color: var(--text-secondary);">
                            Connect wallet to see your referrals
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <div class="referral-section">
            <h2>📚 How Referrals Work</h2>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-top: 20px;">
                <div>
                    <h4 style="color: var(--primary); margin-bottom: 10px;">🥉 Level 1 (Direct)</h4>
                    <p style="color: var(--text-secondary); font-size: 14px;">
                        You directly refer a seller → You get 30% of their platform fees forever
                    </p>
                </div>
                <div>
                    <h4 style="color: var(--secondary); margin-bottom: 10px;">🥈 Level 2</h4>
                    <p style="color: var(--text-secondary); font-size: 14px;">
                        Your referral refers someone → You get 10% of their platform fees
                    </p>
                </div>
                <div>
                    <h4 style="color: var(--warning); margin-bottom: 10px;">🥉 Level 3</h4>
                    <p style="color: var(--text-secondary); font-size: 14px;">
                        Level 2 refers someone → You get 5% of their platform fees
                    </p>
                </div>
            </div>
        </div>
        
        <footer>
            <p>BotEdge Referral Dashboard — Base Sepolia Testnet</p>
            <p>Contract: 0xd8b934580fcE35a11B58C6D73aDeE468a2833fa8</p>
        </footer>
    </div>
    
    <div class="notification" id="notification"></div>
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/6.9.0/ethers.umd.min.js"></script>
    <script>
        const CONTRACT_ADDRESS = '0xd8b934580fcE35a11B58C6D73aDeE468a2833fa8';
        const TREASURY_ADDRESS = '0x0D55451c1e0bE30aaB5b62F85625505e192CFD82';
        
        const CONTRACT_ABI = [
            "function referralEarnings(address) view returns (uint256)",
            "function referralCount(address) view returns (uint256)",
            "function getReferral(address _user, uint256 _index) view returns (address)",
            "function referrer(address) view returns (address)",
            "function claimReferralEarnings()"
        ];
        
        let provider, signer, contract, userAddress;
        
        async function connectWallet() {
            if (typeof window.ethereum === 'undefined') {
                showNotification('Please install a Web3 wallet (MetaMask, Coinbase, Rainbow, etc.)', 'error');
                return;
            }
            try {
                provider = new ethers.BrowserProvider(window.ethereum);
                signer = await provider.getSigner();
                userAddress = await signer.getAddress();
                contract = new ethers.Contract(CONTRACT_ADDRESS, CONTRACT_ABI, signer);
                
                document.getElementById('walletStatus').textContent = 
                    userAddress.slice(0, 6) + '...' + userAddress.slice(-4);
                
                const referralLink = `https://botedge-marketplace.netlify.app/?ref=${userAddress}`;
                document.getElementById('referralLink').value = referralLink;
                
                showNotification('Wallet connected!', 'success');
                await loadReferralData();
            } catch (error) {
                showNotification('Failed to connect wallet', 'error');
            }
        }
        
        async function loadReferralData() {
            if (!contract) return;
            
            try {
                const earnings = await contract.referralEarnings(userAddress);
                const earningsETH = ethers.formatEther(earnings);
                
                const count = await contract.referralCount(userAddress);
                
                document.getElementById('claimableEarnings').textContent = earningsETH + ' ETH';
                document.getElementById('totalEarned').textContent = earningsETH + ' ETH';
                document.getElementById('claimAmount').textContent = earningsETH + ' ETH';
                document.getElementById('totalReferrals').textContent = count.toString();
                document.getElementById('level1Count').textContent = count.toString();
                
                await loadReferralList(count);
            } catch (error) {
                console.error('Error loading referral data:', error);
            }
        }
        
        async function loadReferralList(count) {
            const tbody = document.getElementById('referralsTableBody');
            
            if (count === 0) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--text-secondary);">No referrals yet. Share your link!</td></tr>';
                return;
            }
            
            let rows = '';
            for (let i = 0; i < count && i < 10; i++) {
                try {
                    const referred = await contract.getReferral(userAddress, i);
                    const addressShort = referred.slice(0, 6) + '...' + referred.slice(-4);
                    
                    rows += `
                        <tr>
                            <td>${addressShort}</td>
                            <td><span class="level-badge level-1">Level 1</span></td>
                            <td><span class="status-badge status-active">Active</span></td>
                            <td>-- ETH</td>
                            <td>30%</td>
                        </tr>
                    `;
                } catch (error) {
                    console.error('Error loading referral ' + i, error);
                }
            }
            
            tbody.innerHTML = rows;
        }
        
        async function claimEarnings() {
            if (!contract) {
                showNotification('Please connect wallet first', 'error');
                return;
            }
            
            try {
                const tx = await contract.claimReferralEarnings();
                showNotification('Claiming earnings... Please wait for transaction to confirm.', 'success');
                await tx.wait();
                showNotification('Earnings claimed successfully!', 'success');
                await loadReferralData();
            } catch (error) {
                showNotification('Claim failed: ' + error.message, 'error');
            }
        }
        
        function copyLink() {
            const link = document.getElementById('referralLink');
            link.select();
            document.execCommand('copy');
            showNotification('Link copied to clipboard!', 'success');
        }
        
        function shareTwitter() {
            const link = document.getElementById('referralLink').value;
            const text = encodeURIComponent('Earn crypto by listing your trading bot services on BotEdge!');
            window.open(`https://twitter.com/intent/tweet?text=${text}&url=${link}`, '_blank');
        }
        
        function showNotification(message, type) {
            const notification = document.getElementById('notification');
            notification.textContent = message;
            notification.className = 'notification ' + type + ' show';
            setTimeout(() => notification.classList.remove('show'), 3000);
        }
    </script>
</body>
</html>
